{
  "name": "hrsh",
  "main": "worker/src/index.ts",
  "compatibility_date": "2024-03-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "RoomDurableObject"
      },
      {
        "name": "LIVE_INDEX",
        "class_name": "LiveIndexDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["RoomDurableObject", "LiveIndexDurableObject"]
    }
  ]
}
