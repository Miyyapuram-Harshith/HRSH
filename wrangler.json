{
	"name": "hrsh",
	"main": "worker/src/index.ts",
	"compatibility_date": "2024-03-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM",
				"class_name": "RoomDurableObject"
			},
			{
				"name": "LIVE_INDEX",
				"class_name": "LiveIndexDurableObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RoomDurableObject",
				"LiveIndexDurableObject"
			]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hrsh-db",
			"database_id": "placeholder-id-replace-me"
		},
		{
			"binding": "hrsh_db",
			"database_name": "hrsh-db",
			"database_id": "8dc9bcf3-64d8-4640-91d3-939b21089b5d"
		}
	]
}